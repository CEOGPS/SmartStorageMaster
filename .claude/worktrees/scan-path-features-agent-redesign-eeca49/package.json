{
  "name": "storage-manager-desktop",
  "version": "1.0.0",
  "description": "AI-Powered Storage Manager Desktop Application",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "npm run build:frontend && electron-builder",
    "build:frontend": "cd frontend && npm run build && cd ..",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.storagemanager.app",
    "productName": "Storage Manager Pro",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "desktop/**/*",
      "frontend/dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
